description <https://fireforce6.github.io/mission-control/system-analysis/connections#> as connections {

	extends <https://fireforce6.github.io/mission-control/system-analysis/components#> as components

	uses <https://www.modelware.io/sierra/component#> as component

    // =========================================================================
    //  YLK Added 09-08-2026: 
    // =========================================================================

    // =========================================================================
    // BIOMEDICAL TELEMETRY SIGNALS
    // =========================================================================

    instance BioTelemetrySignal : component:Signal []
    instance RawGasSampleData : component:Signal []
    instance RawBiosignalData : component:Signal []
    instance EncryptedHealthRecord : component:Signal []

    // =========================================================================
    // PORTS DEFINITIONS & ASSIGNMENTS
    // =========================================================================

    // 1. Gas Exposure Acquisition Sensor
    ref instance components:BiomarkerGasAnalyzer [
        component:hasPort BiomarkerGasAnalyzer.Data_Out
    ]
    instance BiomarkerGasAnalyzer.Data_Out : component:Port [ 
        component:direction "Out" 
    ]

    // 2. Biosignal / ECG Acquisition Digitizer
    ref instance components:VitalsECGDigitizer [
        component:hasPort VitalsECGDigitizer.Waveform_Out
    ]
    instance VitalsECGDigitizer.Waveform_Out : component:Port [ 
        component:direction "Out" 
    ]

    // 3. Clinical Telemetry Processor (Analysis Tool)
    ref instance components:ClinicalTelemetryProcessor [
        component:hasPort ClinicalTelemetryProcessor.GasData_In
        component:hasPort ClinicalTelemetryProcessor.ECG_In
        component:hasPort ClinicalTelemetryProcessor.Vault_Out
        component:hasPort ClinicalTelemetryProcessor.Tlm_Out
    ]
    instance ClinicalTelemetryProcessor.GasData_In : component:Port [ 
        component:direction "In" 
    ]
    instance ClinicalTelemetryProcessor.ECG_In : component:Port [ 
        component:direction "In" 
    ]
    instance ClinicalTelemetryProcessor.Vault_Out : component:Port [ 
        component:direction "Out" 
    ]
    instance ClinicalTelemetryProcessor.Tlm_Out : component:Port [ 
        component:direction "Out" 
    ]

    // 4. Clinical Storage Vault
    ref instance components:ClinicalStorageVault [
        component:hasPort ClinicalStorageVault.Archive_In
    ]
    instance ClinicalStorageVault.Archive_In : component:Port [ 
        component:direction "In" 
    ]

    // 5. Biomedical Telemetry Gateway / Bus Adapter
    ref instance components:BioDataGateway [
        component:hasPort BioDataGateway.Processor_In
        component:hasPort BioDataGateway.SpaceWire_Out
    ]
    instance BioDataGateway.Processor_In : component:Port [ 
        component:direction "In" 
    ]
    instance BioDataGateway.SpaceWire_Out : component:Port [ 
        component:direction "Out" 
    ]

    // =========================================================================
    // CONNECTIONS (RELATION INSTANCES)
    // =========================================================================

    // Acquisition -> Analysis (Gas Sensor to Processor)
    relation instance Conn_GasAnalyzer_to_Processor : component:Connection [
        from BiomarkerGasAnalyzer.Data_Out
        to ClinicalTelemetryProcessor.GasData_In
        component:transfers RawGasSampleData
    ]

    // Acquisition -> Analysis (ECG Digitizer to Processor)
    relation instance Conn_ECGDigitizer_to_Processor : component:Connection [
        from VitalsECGDigitizer.Waveform_Out
        to ClinicalTelemetryProcessor.ECG_In
        component:transfers RawBiosignalData
    ]

    // Analysis -> Storage (Processor to Encrypted Vault)
    relation instance Conn_Processor_to_StorageVault : component:Connection [
        from ClinicalTelemetryProcessor.Vault_Out
        to ClinicalStorageVault.Archive_In
        component:transfers EncryptedHealthRecord
    ]

    // Analysis -> Gateway (Processor to Telemetry Bridge)
    relation instance Conn_Processor_to_BioGateway : component:Connection [
        from ClinicalTelemetryProcessor.Tlm_Out
        to BioDataGateway.Processor_In
        component:transfers BioTelemetrySignal
    ]

    // Gateway -> Platform Telemetry Bus (Joining FireSat Platform Data Flow)
    relation instance Conn_BioGateway_to_Platform : component:Connection [
        from BioDataGateway.SpaceWire_Out
        to Platform.Data_In
        component:transfers BioTelemetrySignal
    ]

    // =========================================================================
    // =========================================================================


    ref instance components:FireSat [
        component:hasPort FireSat.Command_In
        component:hasPort FireSat.Telemetry_Out
    ]
    instance FireSat.Command_In : component:Port [ component:direction "In" ]
    instance FireSat.Telemetry_Out : component:Port [ component:direction "Out" ]

    ref instance components:Payload [
        component:hasPort Payload.Data_Out
        component:hasPort Payload.Power_In
    ]
    instance Payload.Data_Out : component:Port [ component:direction "Out" ]
    instance Payload.Power_In : component:Port [ component:direction "In" ]

    ref instance components:Platform [
        component:hasPort Platform.Data_In
        component:hasPort Platform.Data_Out
        component:hasPort Platform.Power_Out
        component:hasPort Platform.Command_In
    ]
    instance Platform.Data_In : component:Port [ component:direction "In" ]
    instance Platform.Data_Out : component:Port [ component:direction "Out" ]
    instance Platform.Power_Out : component:Port [ component:direction "Out" ]
    instance Platform.Command_In : component:Port [ component:direction "In" ]

    ref instance components:PropulsionSegment [
        component:hasPort Propulsion.Command_In
        component:hasPort Propulsion.Power_In
    ]
    instance Propulsion.Command_In : component:Port [ component:direction "In" ]
    instance Propulsion.Power_In : component:Port [ component:direction "In" ]

    instance TelemetrySignal : component:Signal []
    instance CommandSignal : component:Signal []
    instance ElectricalPower : component:Energy []

    relation instance Conn_FireSatCmd_to_Platform : component:Connection [
        from FireSat.Command_In
        to Platform.Command_In
        component:transfers CommandSignal
    ]

    relation instance Conn_PlatformPower_to_Payload : component:Connection [
        from Platform.Power_Out
        to Payload.Power_In
        component:transfers ElectricalPower
    ]

    relation instance Conn_PlatformPower_to_Propulsion : component:Connection [
        from Platform.Power_Out
        to Propulsion.Power_In
        component:transfers ElectricalPower
    ]

    relation instance Conn_Payload_to_Platform : component:Connection [
        from Payload.Data_Out
        to Platform.Data_In
        component:transfers TelemetrySignal
    ]

    relation instance Conn_Platform_to_FireSatTelem : component:Connection [
        from Platform.Data_Out
        to FireSat.Telemetry_Out
        component:transfers TelemetrySignal
    ]

}
